GROQ_API_KEY=
LOG_LEVEL=INFO
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173"]
# Required for /api/admin/* endpoints (send as X-Admin-Key header)
ADMIN_API_KEY=
RATE_LIMIT_PER_MINUTE=30

LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_EXTRACTION_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=1800
LLM_TPM_LIMIT=8000
EVIDENCE_TOKEN_BUDGET=4500
LLM_MAX_RETRIES=2

EMBEDDING_MODEL=all-MiniLM-L6-v2
CHROMA_COLLECTION_NAME=mustang_workshop_manual

CHUNK_TARGET_TOKENS=550
CHUNK_MAX_TOKENS=900
CHUNK_OVERLAP=60
HEADING_SPLIT_WORD_THRESHOLD=400

RETRIEVAL_TOP_K=5
DENSE_CANDIDATES=30
BM25_CANDIDATES=30
RRF_K=60
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

READINESS_THRESHOLD=0.85
MIN_REQUIRED_SLOT_CONFIDENCE=0.80
MAX_INTAKE_TURNS=8
REQUIRE_CONFIRMATION_FOR_INFERRED_VEHICLE_FIELDS=true

SESSION_MESSAGE_LIMIT=20
SESSION_EXPIRY_DAYS=7

INGESTION_BATCH_SIZE=25
OCR_ENABLED=true
FIGURE_OCR_ENABLED=true
LLM_REASONING_EFFORT=low
